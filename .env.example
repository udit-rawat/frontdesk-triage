# Groq (free tier). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=openai/gpt-oss-20b

# Google AI Studio (free tier), optional. Adds a second provider to the end of the
# attempt ladder so an outage at Groq does not take the whole model layer with it.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash
GEMINI_REASONING_EFFORT=low
